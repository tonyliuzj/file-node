# File Node environment configuration.
# Copy to .env.local. Every value here is optional.

# Secret used to sign sessions and encrypt backend credentials. Leave it unset and a random one is
# generated and kept in data/secret.key. If you set one, make it random and private:
#   openssl rand -base64 32
# Never reuse an example value: anyone who can read it can sign in as admin.
# FILE_NODE_SECRET_KEY=

# Trust the Host header behind reverse proxies and custom domains.
AUTH_TRUST_HOST=true

# SQLite database path, relative to the app directory unless absolute.
DATABASE_URL=data/data.db

# Server port.
PORT=3000

# Optional: require this token on the first-run /setup form, so nobody who finds a fresh server
# can claim the admin account before you do.
# FILE_NODE_SETUP_TOKEN=

# Recovery only: switch every Turnstile check off if a wrong key locked you out of sign-in.
# Fix the keys in /admin/settings, then remove this and restart.
# FILE_NODE_DISABLE_TURNSTILE=1

# Set to 1 when a reverse proxy in front of the app sets CF-Connecting-IP / X-Real-IP /
# X-Forwarded-For. Enables per-client rate limits and binds Turnstile clearances to the client.
# Leave it unset when clients connect directly, because those headers can then be forged.
# FILE_NODE_TRUST_PROXY=1
